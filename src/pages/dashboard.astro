---
import Layout from "@/layouts/Layout.astro";
import AccountMenu from "@/components/AccountMenu";
import LinksDashboard from "@/components/LinksDashboard";
import { createClient } from "@/lib/supabase";
import { SUPABASE_URL, SUPABASE_KEY } from "astro:env/server";
import type { Link } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let connected = false;
let initialLinks: Link[] = [];

if (supabase && user) {
  const [telegramResult, linksResult] = await Promise.all([
    supabase.from("telegram_links").select("telegram_id").eq("user_id", user.id).maybeSingle(),
    supabase.from("links").select("*").order("created_at", { ascending: false }),
  ]);
  connected = !!telegramResult.data;
  initialLinks = (linksResult.data ?? []) as Link[];
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <div class="mb-4 flex items-center justify-between rounded-xl border border-white/10 bg-white/5 px-4 py-2">
        <span class="text-sm font-semibold text-white/70">tabzero</span>
        <AccountMenu client:load email={user?.email ?? ""} connected={connected} />
      </div>

      <LinksDashboard
        client:only="react"
        initialLinks={initialLinks}
        userId={user?.id ?? ""}
        supabaseUrl={SUPABASE_URL ?? ""}
        supabaseAnonKey={SUPABASE_KEY ?? ""}
      />
    </div>
  </div>
</Layout>
